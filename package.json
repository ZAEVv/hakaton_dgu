{
  "name": "upk-digital-assistant",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web \".venv/bin/python -m uvicorn server.app:app --host 0.0.0.0 --port 3001 --reload\" \"vite --host 0.0.0.0\"",
    "build": "vite build",
    "start": ".venv/bin/python -m uvicorn server.app:app --host 0.0.0.0 --port 3001",
    "test": ".venv/bin/python -m pytest -q tests",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "lucide-react": "^0.468.0"
  },
  "devDependencies": {
    "vite": "^7.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "concurrently": "^9.2.0",
    "@playwright/test": "^1.56.0"
  }
}
