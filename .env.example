PORT=3001
HOST=0.0.0.0
# Адрес, доступный смартфонам. Для локальной сети: http://192.168.1.10:5173
PUBLIC_URL=http://localhost:5173
# Ключ хранится только на сервере. После изменения перезапустите npm run dev.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
# Необязательно: установите перед первым запуском; иначе пароли генерируются автоматически.
ADMIN_PASSWORD=
STAFF_PASSWORD=
# В production используйте HTTPS и COOKIE_SECURE=true
COOKIE_SECURE=false
