# Generate a unique persistent secret; see README. Never commit the real value.
SECRET_KEY=
# 1 requires HTTPS; use 0 only for local HTTP development.
SESSION_COOKIE_SECURE=1
# Paths are relative to the assistant directory.
DATABASE=helpdesk.sqlite3
UPLOAD_DIR=uploads
# Add your server domain or LAN IP before opening the app on another device.
TRUSTED_HOSTS=localhost,127.0.0.1,[::1]
# Optional demo employee password; leave empty to generate a random password.
DEMO_PASSWORD=
# DeepSeek assistant: keep the actual key private.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
# Explicitly enable sample answers only for demonstrations, not official guidance.
DEEPSEEK_DEMO_KNOWLEDGE=0
