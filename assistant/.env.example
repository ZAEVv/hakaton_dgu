# Paths are relative to the assistant directory.
DATABASE=helpdesk.sqlite3
UPLOAD_DIR=uploads
# Add your server domain or LAN IP before opening the app on another device.
TRUSTED_HOSTS=localhost,127.0.0.1,[::1]
# Optional: no external API is used by the ticket form yet.
API_KEY=
# Optional demo employee password; leave empty to generate a random password.
DEMO_PASSWORD=
